# Frontend environment variables
# When unset or empty, Next.js rewrites all /api/* requests to DEER_FLOW_INTERNAL_GATEWAY_BASE_URL (default http://127.0.0.1:8001)
# DEER_FLOW_INTERNAL_GATEWAY_BASE_URL=http://127.0.0.1:8001
# NEXT_PUBLIC_BACKEND_BASE_URL=
# NEXT_PUBLIC_LANGGRAPH_BASE_URL=
NODE_ENV=development
